# Frontend
VITE_API_URL=https://your-aura-api.vercel.app

# Server
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://your-aura-frontend.vercel.app

# AI — leave blank unless you want a live provider; mock mode works without keys
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# fast | normal | slow — simulated infrastructure latency around real tool calls
DEMO_PACING=normal

# SQLite file. Use a writable local path in dev or a writable temp path in hosted environments.
AURA_DB_PATH=/tmp/aura.sqlite

# Optional sign-in. Leave blank to keep demo mode without accounts.
# The Slack secret stays on the server and is never sent to the browser.
GOOGLE_CLIENT_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-aura-frontend.vercel.app/api/auth/slack/callback
