# Server
PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# AI — the demo works with no key when AI_PROVIDER=mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

# fast | normal | slow — delay is simulated infrastructure latency around real tool calls
DEMO_PACING=normal

# SQLite file. Created on boot. Ephemeral hosts re-seed themselves.
AURA_DB_PATH=./server/data/aura.sqlite

# Optional sign-in. Leave blank to keep demo mode without accounts.
# The Slack secret stays on the server and is never sent to the browser.
GOOGLE_CLIENT_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5173/api/auth/slack/callback
